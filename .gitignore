# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
worker/dist/
dist/

# ---- 本地密钥 / 环境变量（.dev.vars.example 是模板，会被跟踪）----
.dev.vars
.env
.env.local
*.tmp

# ---- 日志与调试 ----
debug.log
*.log

# ---- 临时打包产物（esbuild 直出）----
tmp/

# ---- Agent 工作区（本地记忆，含内部笔记，不入库）----
.workbuddy/

# ---- 本地数据留底（含知识库词条内容；仓库是 public，数据一律不入库）----
backups/*.json

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
